NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=peaq-integration

# Network selection: mainnet | agung
PEAQ_NETWORK=agung

# RPC endpoints. Defaults shipped from networks.ts; override only for private nodes.
# Mainnet:
#   PEAQ_WSS_URL=wss://peaq-rpc.publicnode.com
#   PEAQ_HTTPS_URL=https://peaq-rpc.publicnode.com
# Agung:
#   PEAQ_WSS_URL=wss://wss-async.agung.peaq.network
#   PEAQ_HTTPS_URL=https://peaq-agung.api.onfinality.io/public

PEAQ_WSS_URL=
PEAQ_HTTPS_URL=

# Substrate signer seed (sr25519 mnemonic). NEVER commit. Use Secrets Manager
# or HashiCorp Vault in production. Agung dev keys are fine for local; mainnet
# requires a hardware-backed signer.
PEAQ_SIGNER_MNEMONIC=

# EVM signer (for Merkle anchor extrinsic via EVM precompile). Use a separate
# key from Substrate so a compromise of one path is contained.
PEAQ_EVM_PRIVATE_KEY=

# Anchor target address. Used as the calldata-only sink for daily Merkle root
# submissions. Default: zero address (calldata is the payload, value is 0).
PEAQ_ANCHOR_TO_ADDRESS=0x000000000000000000000000000000000000dEaD

# DID issuer base. Used as the controller for newly minted did:peaq DIDs.
# Format: did:peaq:<sr25519-public-key-as-base58> derived from the signer.
PEAQ_DID_CONTROLLER=

# Retry tuning (defaults are conservative)
PEAQ_RETRY_MAX_ATTEMPTS=5
PEAQ_RETRY_BASE_MS=500
PEAQ_RETRY_MAX_MS=30000

# Observability
SENTRY_DSN=
